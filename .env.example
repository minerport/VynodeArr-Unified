# Copy this file to .env. Never commit actual credentials.
# Web address: http://localhost:8686 by default.
VYNODEARR_PORT=8686
VYNODEARR_BIND_ADDRESS=0.0.0.0
VYNODEARR_SECURE_COOKIES=false
TZ=America/New_York
# Linux host ownership used by the bundled movie and television engines.
PUID=1000
PGID=1000

VYNODEARR_DATA_MODE=engine
VYNODEARR_DATA_DIR=/data
VYNODEARR_SYNC_INTERVAL_MS=900000
VYNODEARR_CACHE_MAX_ITEMS=5000
# Required only when the encrypted credential vault is used.
VYNODEARR_MASTER_KEY=
# Or mount a stable secret file:
VYNODEARR_MASTER_KEY_FILE=

MOVIE_ENGINE_ENABLED=true
MOVIE_ENGINE_HOST=movie-engine
MOVIE_ENGINE_PORT=7878
MOVIE_ENGINE_HTTPS=false
MOVIE_ENGINE_URL_BASE=
# Optional explicit first-run key. Leave blank to generate and persist one.
MOVIE_ENGINE_API_CREDENTIAL=
# Prefer a mounted secret file for an externally managed deployment:
MOVIE_ENGINE_API_CREDENTIAL_FILE=
MOVIE_ENGINE_TIMEOUT_MS=8000
MOVIE_ENGINE_RETRIES=1
MOVIE_ENGINE_TLS_VERIFY=true
MOVIE_ENGINE_FIXTURE_FALLBACK=false

TV_ENGINE_ENABLED=true
TV_ENGINE_HOST=tv-engine
TV_ENGINE_PORT=8989
TV_ENGINE_HTTPS=false
TV_ENGINE_URL_BASE=
TV_ENGINE_API_CREDENTIAL=
TV_ENGINE_API_CREDENTIAL_FILE=
TV_ENGINE_TIMEOUT_MS=8000
TV_ENGINE_RETRIES=1
TV_ENGINE_TLS_VERIFY=true
TV_ENGINE_FIXTURE_FALLBACK=false

# Optional first-run bootstrap for Discover. It can also be added or replaced
# later under Service Settings > Discover. Keep the real value in .env only.
TMDB_API_READ_TOKEN=
