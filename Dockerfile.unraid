FROM alpine:3.22 AS engines
ARG RADARR_VERSION=6.3.0.10514
ARG SONARR_VERSION=4.0.19.2979
RUN apk add --no-cache curl tar \
    && mkdir -p /opt/engines \
    && curl -fsSL "https://github.com/Radarr/Radarr/releases/download/v${RADARR_VERSION}/Radarr.master.${RADARR_VERSION}.linux-musl-core-x64.tar.gz" \
      | tar -xz -C /opt/engines \
    && curl -fsSL "https://github.com/Sonarr/Sonarr/releases/download/v${SONARR_VERSION}/Sonarr.main.${SONARR_VERSION}.linux-musl-x64.tar.gz" \
      | tar -xz -C /opt/engines

FROM node:22.22.2-alpine3.23 AS request-source
ARG VYNODESEERR_COMMIT=46d80335991cc7c5a9e1c501e274f5a90a6c07c9
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV NEXT_TELEMETRY_DISABLED=1
RUN apk add --no-cache git \
    && corepack enable \
    && git clone --filter=blob:none https://github.com/minerport/VynodeSeerr.git /request-engine \
    && cd /request-engine \
    && git checkout "$VYNODESEERR_COMMIT"
WORKDIR /request-engine

FROM request-source AS request-production-dependencies
RUN CI=true pnpm install --prod --frozen-lockfile

FROM request-source AS request-build
RUN apk add --no-cache python3 make g++ gcc libc6-compat bash \
    && CYPRESS_INSTALL_BINARY=0 pnpm install --frozen-lockfile \
    && pnpm build \
    && rm -rf .next/cache

FROM node:22.22.2-alpine3.23 AS request-engine
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /request-engine
COPY --from=request-source /request-engine /request-engine
COPY --from=request-production-dependencies /request-engine/node_modules ./node_modules
COPY --from=request-build /request-engine/.next ./.next
COPY --from=request-build /request-engine/dist ./dist
RUN rm -rf .git

FROM node:22-alpine
LABEL org.opencontainers.image.title="VynodeArr" \
      org.opencontainers.image.description="Unified movie and television management for Unraid" \
      org.opencontainers.image.source="https://github.com/minerport/VynodeArr-Unified" \
      org.opencontainers.image.version="1.0.13" \
      org.opencontainers.image.licenses="Apache-2.0"
RUN apk add --no-cache icu-libs sqlite-libs libgcc libstdc++ tzdata tini
WORKDIR /app
COPY package.json ./
COPY apps ./apps
COPY packages ./packages
COPY OPEN_SOURCE_NOTICES LICENSE THIRD_PARTY_NOTICES ./
COPY --from=engines /opt/engines/Radarr /opt/vynodearr/movies
COPY --from=engines /opt/engines/Sonarr /opt/vynodearr/television
COPY --from=request-engine /request-engine /opt/vynodearr/requests
COPY infrastructure/unraid/entrypoint.sh /usr/local/bin/vynodearr-entrypoint
RUN chmod 755 /usr/local/bin/vynodearr-entrypoint \
    && addgroup -S vynodearr && adduser -S -G vynodearr -u 10001 vynodearr \
    && mkdir -p /config /config/requests /movies /tv /downloads \
    && chown -R vynodearr:vynodearr /config /movies /tv /downloads
ENV NODE_ENV=production PORT=8686 VYNODEARR_DATA_DIR=/config/vynodearr \
    VYNODEARR_DATA_MODE=engine VYNODEARR_BUNDLED_ENGINES=true \
    VYNODEARR_BOOTSTRAP_ROOT_FOLDERS=true VYNODEARR_SECURE_COOKIES=false \
    MOVIE_ENGINE_HOST=127.0.0.1 \
    MOVIE_ENGINE_PORT=7878 TV_ENGINE_HOST=127.0.0.1 TV_ENGINE_PORT=8989 \
    REQUEST_ENGINE_HOST=127.0.0.1 REQUEST_ENGINE_PORT=5055 \
    REQUEST_ENGINE_CONFIG_PATH=/config/requests/settings.json \
    VYNODEARR_AUTO_CONFIGURE_REQUESTS=true \
    MOVIE_ENGINE_CONFIG_PATH=/config/movies/config.xml \
    TV_ENGINE_CONFIG_PATH=/config/television/config.xml
VOLUME ["/config", "/movies", "/tv", "/downloads"]
EXPOSE 8686
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD node -e "Promise.all([fetch('http://127.0.0.1:8686/healthz'),fetch('http://127.0.0.1:7878/ping'),fetch('http://127.0.0.1:8989/ping'),fetch('http://127.0.0.1:5055/api/v1/status')]).then(rs=>{if(rs.some(r=>!r.ok))process.exit(1)}).catch(()=>process.exit(1))"
ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/vynodearr-entrypoint"]
